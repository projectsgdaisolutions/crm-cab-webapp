# vehico CRM — CAB Service CRM (Frontend)

# PHP API used by this Vite app (import.meta.env.VITE_API_BASE_URL).
# Production:
VITE_API_BASE_URL=https://vehicocrm.gdaisolutions.com/api
# Local PHP server (backend/start-local.ps1):
# VITE_API_BASE_URL=http://localhost:8000/api

# Request timeout (ms)
VITE_API_TIMEOUT=15000

# Application metadata
VITE_APP_NAME=vehico CRM CAB CRM
VITE_APP_TAGLINE=Built on Innovation. Powered by Intelligence.

# PHP backend only. Configure these in the PHP process environment, not Vite.
# Never prefix SMTP credentials or reset secrets with VITE_.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=vehico CRM
FRONTEND_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_RATE_KEY=
