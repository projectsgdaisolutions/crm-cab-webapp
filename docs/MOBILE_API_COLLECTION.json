        { "name": "Get preferences", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/preferences.php" } },
        { "name": "Save preferences", "request": { "method": "PUT", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/preferences.php" } }
